{
  "expo": {
    "name": "Kanat",
    "slug": "kanat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tr.edu.wpu.kanat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tr.edu.wpu.kanat"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kanat, ailenin seni bulabilmesi için konumunu ebeveyninle paylaşır.",
          "locationAlwaysAndWhenInUsePermission": "Kanat, uygulama kapalıyken de konumunu ebeveyninle paylaşır. Paylaşım açıkken bunu her zaman görürsün.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "process.env.GOOGLE_MAPS_API_KEY"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F46E5",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (expo-task-manager arka plan konumu) Room ile çalışır; R8 üretilen _Impl sınıflarını silmesin.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.** { *; }\n-keep class expo.modules.taskManager.** { *; }\n-keep class expo.modules.location.** { *; }"
          }
        }
      ]
    ],
    "scheme": "kanat",
    "experiments": {
      "typedRoutes": true
    }
  }
}
